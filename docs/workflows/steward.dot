digraph steward {
  rankdir=LR; nodesep=0.4; ranksep=0.6; bgcolor="white";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#D9D9D6", fillcolor="white", penwidth=1.2];
  edge [fontname="Helvetica", fontsize=8.5, color="#6B6F73", arrowsize=0.7];
  table [label="Table page\n\"Ask steward to describe attributes\"\n(Project Manager / Admin)", fillcolor="#FFF6E5"];
  msg [label="Inbox message + e-mail copy\nto the effective data steward\n(with link to the table)", fillcolor="#E4EEF7"];
  dash [label="Steward's My Dashboard\n\"Waiting for my action\"", fillcolor="#E4EEF7"];
  edit [label="Steward documents the\nattributes (descriptions,\nglossary terms, sensitivity)", fillcolor="#E8F5E9", color="#2E7D32"];
  table -> msg [label="send"]; msg -> dash; dash -> edit [label="opens table"];
}
