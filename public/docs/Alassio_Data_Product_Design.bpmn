<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_design" targetNamespace="https://alassio.example/bpmn">
<bpmn:collaboration id="Collab"><bpmn:participant id="Pool" name="Data product design" processRef="Proc"/></bpmn:collaboration>
<bpmn:process id="Proc" isExecutable="false">
<bpmn:laneSet id="Lanes">
<bpmn:lane id="Lane_pm" name="Project Manager (submitter)">
<bpmn:flowNodeRef>start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>design</bpmn:flowNodeRef>
<bpmn:flowNodeRef>signoff</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rework</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gwc</bpmn:flowNodeRef>
<bpmn:flowNodeRef>withdrawn</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_ba" name="Business Analyst / Req. Engineer">
<bpmn:flowNodeRef>refine1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>doc</bpmn:flowNodeRef>
<bpmn:flowNodeRef>refine</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gwr</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_owner" name="BPO (business process owner)">
<bpmn:flowNodeRef>reviewo</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gwo</bpmn:flowNodeRef>
<bpmn:flowNodeRef>attach</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_di" name="Data Ingestion">
<bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_dpd" name="Data Product Development">
<bpmn:flowNodeRef>dev</bpmn:flowNodeRef>
<bpmn:flowNodeRef>uat</bpmn:flowNodeRef>
<bpmn:flowNodeRef>sit</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>release</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_sys" name="Alassio Data Catalog (system)">
<bpmn:flowNodeRef>tagsrc</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tags</bpmn:flowNodeRef>
<bpmn:flowNodeRef>end</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="start" name="Need for a data product">
<bpmn:outgoing>Flow_0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:userTask id="design" name="Design data product (name, hub type, project, use case, SOURCE tables)">
<bpmn:incoming>Flow_0</bpmn:incoming>
<bpmn:outgoing>Flow_1</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="tagsrc" name="Tag selected SOURCE tables (Data Product, Project, Use Case) — kept in sync">
<bpmn:incoming>Flow_1</bpmn:incoming>
<bpmn:outgoing>Flow_2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="refine1" name="Refine the design (may edit the entries) → notes + optional files">
<bpmn:incoming>Flow_2</bpmn:incoming>
<bpmn:incoming>Flow_9</bpmn:incoming>
<bpmn:incoming>Flow_26</bpmn:incoming>
<bpmn:outgoing>Flow_3</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="gw1" name="Okay?">
<bpmn:incoming>Flow_3</bpmn:incoming>
<bpmn:outgoing>Flow_4</bpmn:outgoing>
<bpmn:outgoing>Flow_5</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="doc" name="Document the sourcing (source system, BPO, LeanIX, steward) → request approval">
<bpmn:incoming>Flow_4</bpmn:incoming>
<bpmn:outgoing>Flow_6</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="reviewo" name="Review intended data use">
<bpmn:incoming>Flow_6</bpmn:incoming>
<bpmn:outgoing>Flow_7</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="gwo" name="Approve?">
<bpmn:incoming>Flow_7</bpmn:incoming>
<bpmn:outgoing>Flow_8</bpmn:outgoing>
<bpmn:outgoing>Flow_9</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="attach" name="Approve data use and attach the confirming document (e-mail / link)">
<bpmn:incoming>Flow_8</bpmn:incoming>
<bpmn:outgoing>Flow_10</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="confirm" name="Confirm ingested tables (with location)">
<bpmn:incoming>Flow_10</bpmn:incoming>
<bpmn:outgoing>Flow_11</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="gw2" name="Confirmed?">
<bpmn:incoming>Flow_11</bpmn:incoming>
<bpmn:outgoing>Flow_12</bpmn:outgoing>
<bpmn:outgoing>Flow_13</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="refine" name="Refine the data product → notes + optional files">
<bpmn:incoming>Flow_12</bpmn:incoming>
<bpmn:outgoing>Flow_14</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="gwr" name="Completed?">
<bpmn:incoming>Flow_14</bpmn:incoming>
<bpmn:outgoing>Flow_15</bpmn:outgoing>
<bpmn:outgoing>Flow_16</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="dev" name="Development (→ notes)">
<bpmn:incoming>Flow_15</bpmn:incoming>
<bpmn:outgoing>Flow_17</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="uat" name="UAT (→ notes)">
<bpmn:incoming>Flow_17</bpmn:incoming>
<bpmn:outgoing>Flow_18</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="sit" name="SIT (→ notes)">
<bpmn:incoming>Flow_18</bpmn:incoming>
<bpmn:outgoing>Flow_19</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="gw3" name="Tests OK?">
<bpmn:incoming>Flow_19</bpmn:incoming>
<bpmn:outgoing>Flow_20</bpmn:outgoing>
<bpmn:outgoing>Flow_21</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="release" name="Release to PRD (→ notes)">
<bpmn:incoming>Flow_20</bpmn:incoming>
<bpmn:outgoing>Flow_22</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="signoff" name="Sign-off">
<bpmn:incoming>Flow_22</bpmn:incoming>
<bpmn:outgoing>Flow_23</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="tags" name="Tag the data product (Data Product, Project, Use Case)">
<bpmn:incoming>Flow_23</bpmn:incoming>
<bpmn:outgoing>Flow_24</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="end" name="Data product delivered">
<bpmn:incoming>Flow_24</bpmn:incoming>
</bpmn:endEvent>
<bpmn:userTask id="rework" name="Rework design (reason from reviewer)">
<bpmn:incoming>Flow_5</bpmn:incoming>
<bpmn:incoming>Flow_13</bpmn:incoming>
<bpmn:incoming>Flow_16</bpmn:incoming>
<bpmn:incoming>Flow_21</bpmn:incoming>
<bpmn:outgoing>Flow_25</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="gwc" name="Continue?">
<bpmn:incoming>Flow_25</bpmn:incoming>
<bpmn:outgoing>Flow_26</bpmn:outgoing>
<bpmn:outgoing>Flow_27</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="withdrawn" name="Withdrawn (with reason)">
<bpmn:incoming>Flow_27</bpmn:incoming>
</bpmn:endEvent>
<bpmn:textAnnotation id="notify"><bpmn:text>Every step notifies the submitter and the next actor (inbox + e-mail copy); hand-offs between roles are automatic</bpmn:text></bpmn:textAnnotation>
<bpmn:sequenceFlow id="Flow_0" name="" sourceRef="start" targetRef="design"/>
<bpmn:sequenceFlow id="Flow_1" name="" sourceRef="design" targetRef="tagsrc"/>
<bpmn:sequenceFlow id="Flow_2" name="automatic" sourceRef="tagsrc" targetRef="refine1"/>
<bpmn:sequenceFlow id="Flow_3" name="" sourceRef="refine1" targetRef="gw1"/>
<bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="gw1" targetRef="doc"/>
<bpmn:sequenceFlow id="Flow_5" name="no · return" sourceRef="gw1" targetRef="rework"/>
<bpmn:sequenceFlow id="Flow_6" name="automatic" sourceRef="doc" targetRef="reviewo"/>
<bpmn:sequenceFlow id="Flow_7" name="" sourceRef="reviewo" targetRef="gwo"/>
<bpmn:sequenceFlow id="Flow_8" name="yes" sourceRef="gwo" targetRef="attach"/>
<bpmn:sequenceFlow id="Flow_9" name="no · decline → back to BA" sourceRef="gwo" targetRef="refine1"/>
<bpmn:sequenceFlow id="Flow_10" name="automatic" sourceRef="attach" targetRef="confirm"/>
<bpmn:sequenceFlow id="Flow_11" name="" sourceRef="confirm" targetRef="gw2"/>
<bpmn:sequenceFlow id="Flow_12" name="yes · automatic" sourceRef="gw2" targetRef="refine"/>
<bpmn:sequenceFlow id="Flow_13" name="no · return" sourceRef="gw2" targetRef="rework"/>
<bpmn:sequenceFlow id="Flow_14" name="" sourceRef="refine" targetRef="gwr"/>
<bpmn:sequenceFlow id="Flow_15" name="yes · automatic" sourceRef="gwr" targetRef="dev"/>
<bpmn:sequenceFlow id="Flow_16" name="no · return" sourceRef="gwr" targetRef="rework"/>
<bpmn:sequenceFlow id="Flow_17" name="" sourceRef="dev" targetRef="uat"/>
<bpmn:sequenceFlow id="Flow_18" name="" sourceRef="uat" targetRef="sit"/>
<bpmn:sequenceFlow id="Flow_19" name="" sourceRef="sit" targetRef="gw3"/>
<bpmn:sequenceFlow id="Flow_20" name="yes" sourceRef="gw3" targetRef="release"/>
<bpmn:sequenceFlow id="Flow_21" name="no · return" sourceRef="gw3" targetRef="rework"/>
<bpmn:sequenceFlow id="Flow_22" name="" sourceRef="release" targetRef="signoff"/>
<bpmn:sequenceFlow id="Flow_23" name="" sourceRef="signoff" targetRef="tags"/>
<bpmn:sequenceFlow id="Flow_24" name="" sourceRef="tags" targetRef="end"/>
<bpmn:sequenceFlow id="Flow_25" name="" sourceRef="rework" targetRef="gwc"/>
<bpmn:sequenceFlow id="Flow_26" name="yes · forward again to the returning step" sourceRef="gwc" targetRef="refine1"/>
<bpmn:sequenceFlow id="Flow_27" name="no · withdraw" sourceRef="gwc" targetRef="withdrawn"/>
</bpmn:process>
